rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.uid == 'o774wL9hUVSi19EkDCgLqQomP8i2';
    }
    function factorySite(data) {
      return data.siteId in ['samochat', 'bartchat', '415chat', 'gpchat', '27chat', '808chat', 'buffettchat', 'gaichat', 'popechat', 'recruitchat'];
    }
    function notKilled(sid) {
      return !exists(/databases/$(database)/documents/sites/$(sid))
        || get(/databases/$(database)/documents/sites/$(sid)).data.killed != true;
    }
    function hasPostBody(data) {
      return (data.text is string && data.text.size() > 0)
        || (data.keys().hasAll(['imageUrl']) && data.imageUrl is string && data.imageUrl.size() > 0)
        || (data.keys().hasAll(['poll']) && data.poll is map)
        || (data.keys().hasAll(['repostOf']) && data.repostOf is string && data.repostOf.size() > 0)
        || (data.keys().hasAll(['quoteOf']) && data.quoteOf is string && data.quoteOf.size() > 0
            && data.text is string && data.text.size() > 0);
    }
    function textOk(data) {
      return !data.keys().hasAny(['text'])
        || (data.text is string && data.text.size() <= 280);
    }
    function onlyReplyCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
        && request.resource.data.replyCount is int
        && request.resource.data.replyCount == (resource.data.replyCount is int ? resource.data.replyCount : 0) + 1;
    }
    function onlyOwnPollVote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll'])
        && request.resource.data.poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
        && request.resource.data.poll.votes.diff(resource.data.poll.votes).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.poll.votes[request.auth.uid] is int;
    }
    function uidMap(data, field) {
      return data.keys().hasAny([field]) && data[field] is map ? data[field] : {};
    }
    function onlyOwnUidMap(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && uidMap(request.resource.data, field).diff(uidMap(resource.data, field)).affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data[field][request.auth.uid] == true
          || !(request.auth.uid in request.resource.data[field])
        );
    }
    function onlyOwnLike() {
      return onlyOwnUidMap('likes');
    }
    function onlyOwnRepost() {
      return onlyOwnUidMap('reposts');
    }
    function onlyOwnPostEdit() {
      return resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.siteId == resource.data.siteId;
    }
    function ownEdge(targetUid) {
      return emailVerified()
        && request.auth.uid == uid
        && request.auth.uid != targetUid
        && factorySite(request.resource.data)
        && request.resource.data.siteId is string;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if emailVerified()
        && notKilled(request.resource.data.siteId)
        && request.auth.uid == request.resource.data.authorUid
        && factorySite(request.resource.data)
        && hasPostBody(request.resource.data)
        && textOk(request.resource.data);
      allow delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;
      allow update: if emailVerified() && notKilled(resource.data.siteId) && (
        onlyReplyCountBump()
        || onlyOwnPollVote()
        || onlyOwnLike()
        || onlyOwnRepost()
        || onlyOwnPostEdit()
      );
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['siteId'])
        && factorySite(request.resource.data);

      match /blocks/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.blockerUid == uid
          && request.resource.data.targetUid == targetUid
          && factorySite(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /following/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if ownEdge(targetUid)
          && request.resource.data.followerUid == uid
          && request.resource.data.targetUid == targetUid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /mutes/{targetUid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if ownEdge(targetUid)
          && request.resource.data.muterUid == uid
          && request.resource.data.targetUid == targetUid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /bookmarks/{postId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.postId == postId
          && factorySite(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /hidden/{postId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if emailVerified()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.postId == postId
          && factorySite(request.resource.data);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /reports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if emailVerified()
        && request.resource.data.reporterUid == request.auth.uid
        && factorySite(request.resource.data)
        && request.resource.data.postId is string
        && request.resource.data.reason is string;
      allow update, delete: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.siteId == siteId
        && request.resource.data.killed is bool;
      allow delete: if false;
    }
  }
}
